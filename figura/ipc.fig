// CLI / browser extension <-> server IPC protocol
// Served over a Unix domain socket at $XDG_RUNTIME_DIR/vicinae/vicinae.sock

struct PingResponse {
  version: string;
  pid: int;
};

struct DeeplinkRequest {
  url: string;
};

struct DeeplinkResponse {
  error?: string;
};

struct DescribeResponse {
  open: bool;
  entrypoint: string;
};

struct LaunchAppRequest {
  appId: string;
  args: string[];
  newInstance: bool;
};

struct LaunchAppResponse {
  error?: string;
  focusedWindowTitle: string;
};

struct LaunchCommandRequest {
  entrypoint: string;
  args: string[];
  cwd?: string;
  query?: string;
};

struct LaunchCommandResponse {
  error?: string;
};

struct CommandInfo {
  id: string;
  name: string;
};

struct ListCommandsResponse {
  commands: CommandInfo[];
};

enum DMenuOutputFormat {
  Data,
  Index
};

struct DMenuRequest {
  rawContent: string;
  navigationTitle?: string;
  placeholder?: string;
  format: DMenuOutputFormat;
  sectionTitle?: string;
  noSection: bool;
  noQuickLook: bool;
  noIcon: bool;
  noMetadata: bool;
  query?: string;
  width?: int;
  height?: int;
  noFooter: bool;
  password: bool;
};

struct DMenuResponse {
  output: string;
};

struct BrowserInitRequest {
  id: string;
  name: string;
  engine: string;
  version?: string;
  // granted optional permissions, absent on extensions predating optional permissions
  permissions?: string[];
};

struct BrowserTabInfo {
  id: int;
  windowId: int;
  title: string;
  url: string;
  active: bool;
  muted: bool;
  audible: bool;
  lastAccessed: double;
  pinned: bool;
};

struct FocusTabRequest {
  tabId: int;
};

struct CloseTabRequest {
  tabId: int;
};

struct BrowserBookmarkInfo {
  id: string;
  title: string;
  url: string;
  folder: string[];
  dateAdded: double;
};

struct BookmarksRequest {
  requestId: int;
};

struct BrowserBookmarkFolderInfo {
  id: string;
  path: string[];
};

struct BookmarksResponse {
  requestId: int;
  bookmarks: BrowserBookmarkInfo[];
  folders?: BrowserBookmarkFolderInfo[];
  error?: string;
};

struct RemoveBookmarkRequest {
  bookmarkId: string;
};

struct PermissionRequest {
  permission: string;
};

struct SetPinnedRequest {
  tabId: int;
  pinned: bool;
};

struct SetMutedRequest {
  tabId: int;
  muted: bool;
};

struct BookmarkTabRequest {
  tabId: int;
  title: string;
  url: string;
  folderId?: string;
};

struct DuplicateTabRequest {
  tabId: int;
};

struct FileResult {
  path: string;
  score: uint;
  category: string;
  mimeType?: string;
};

struct FsQueryParams {
  limit: int;
  category?: string;
};

service Ipc {
  fn ping() => PingResponse;
  fn deeplink(req: DeeplinkRequest) => DeeplinkResponse;
  fn describe() => DescribeResponse;
  fn launchApp(req: LaunchAppRequest) => LaunchAppResponse;
  fn listCommands() => ListCommandsResponse;
  fn launchCommand(req: LaunchCommandRequest) => LaunchCommandResponse;
  fn dmenu(req: DMenuRequest) => DMenuResponse;
  fn browserInit(req: BrowserInitRequest) => void;
  fn browserTabsChanged(tabs: BrowserTabInfo[]) => void;
  fn browserPermissionsChanged(permissions: string[]) => void;
  fn browserBookmarks(res: BookmarksResponse) => void;

  // filesystem
  fn fsQuery(q: string, params: FsQueryParams) => FileResult[];

  event focusTab(req: FocusTabRequest);
  event closeTab(req: CloseTabRequest);
  event requestBookmarks(req: BookmarksRequest);
  event requestPermission(req: PermissionRequest);
  event removeBookmark(req: RemoveBookmarkRequest);
  event setPinned(req: SetPinnedRequest);
  event setMuted(req: SetMutedRequest);
  event bookmarkTab(req: BookmarkTabRequest);
  event duplicateTab(req: DuplicateTabRequest);
}
